{
  "default_timeout_seconds": 60,
  "tools": {
    "black": {
      "timeout_seconds": 45,
      "timeout_retries": 1,
      "cleanup_patterns": [
        "^python -m black( |$)"
      ],
      "command": [
        "python",
        "-m",
        "black",
        ".",
        "--exclude",
        "/(\\.venv|mdview\\.egg-info)/"
      ]
    },
    "ruff": {
      "timeout_seconds": 45,
      "command": [
        "python",
        "-m",
        "ruff",
        "check",
        "."
      ]
    },
    "compileall": {
      "timeout_seconds": 60,
      "command": [
        "python",
        "-m",
        "compileall",
        "src",
        "tests"
      ]
    },
    "pytest": {
      "timeout_seconds": 120,
      "command": [
        "python",
        "-m",
        "pytest"
      ]
    }
  }
}
